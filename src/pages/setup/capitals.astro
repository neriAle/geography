    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <title>Settings - Guess the Capital</title>
  </head>
  <body class="min-h-screen bg-slate-50">
    <GameSetup
      client:load
      gameTitle="Guess the Capital"
      gameDescription="Test your knowledge by guessing the name of the capital of various countries."
      destinationRoute="/play/capitals"
    />
  </body>
</html>

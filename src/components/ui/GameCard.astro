---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  description: string;
  icon: ImageMetadata;
  href: string;
}

const { title, description, icon, href } = Astro.props;
---

<a
  href={href}
  class="group block rounded-2xl border border-slate-200 bg-white p-6 text-center shadow-sm transition-all duration-200 hover:-translate-y-1 hover:shadow-md"
>
  <div
    class="mx-auto mb-5 h-16 w-16 overflow-hidden drop-shadow-sm transition-transform duration-300 group-hover:scale-105"
  >
    <Image
      src={icon}
      alt={`${title} icon`}
      width={64}
      height={64}
      loading="eager"
      class="h-full w-full object-contain"
    />
  </div>

  <h2
    class="mb-2 text-2xl font-black text-slate-800 transition-colors group-hover:text-(--brand-primary)"
  >
    {title}
  </h2>

  <p class="line-clamp-2 font-medium text-slate-500">
    {description}
  </p>
</a>
